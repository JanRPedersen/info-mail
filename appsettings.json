{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AiShadow": {
    "Enabled": false,
    "Coverage": "Sample",
    "IncludeSharePointKnowledge": false,
    "IncludeExplanation": false,
    "ComparisonListEnabled": false,
    "DataProcessingApproved": false,
    "StartTimeUtc": "",
    "Endpoint": "https://chat-dbs-resource.openai.azure.com/openai/v1/chat/completions",
    "Deployment": "gpt-5.4-mini",
    "DailyRequestLimit": 20,
    "MaximumInputCharacters": 32000
  },
  "Processing": {
    "UseAiRecipientCandidates": false
  },
  "MailRobot": {
    "MailboxAddress": "info@blind.dk",
    "PollingIntervalSeconds": 10,
    "InboxDataPath": "Data/inbox-samples.json",
    "ForwardRecipient": "info@blind.dk",
    "DefaultTargetFolder": "Videresendt via regler",
    "DocumentReferenceFolder": "Documents",
    "ForwardingLogPath": "Data/forwarded-log.json",
    "RoutingRules": [
      {
        "Name": "Order requests",
        "Route": "Forward",
        "Keywords": ["ordre", "bestilling", "levering"]
      },
      {
        "Name": "Invoice review",
        "Route": "Forward",
        "Keywords": ["faktura", "betaling"]
      },
      {
        "Name": "General questions",
        "Route": "ManualReview",
        "Keywords": ["spørgsmål", "samarbejde"]
      }
    ],
    "ForwardingRules": [
      {
        "Name": "Ordre og bestillinger",
        "Keywords": ["ordre", "bestilling", "levering"],
        "ForwardAddresses": ["info@blind.dk"],
        "ForwardWhenAnyKeywordMatches": true,
        "Enabled": true,
        "TargetFolder": "Videresendt via regler"
      },
      {
        "Name": "Faktura og betaling",
        "Keywords": ["faktura", "betaling"],
        "ForwardAddresses": ["info@blind.dk"],
        "ForwardWhenAnyKeywordMatches": true,
        "Enabled": true,
        "TargetFolder": "Videresendt via regler"
      },
      {
        "Name": "Ikke videresend",
        "Keywords": ["ikke videresend", "manuel behandling", "holdes tilbage"],
        "ForwardAddresses": [],
        "ForwardWhenAnyKeywordMatches": true,
        "Enabled": true
      }
    ]
  }
}
