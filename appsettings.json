{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "MailRobot": {
    "MailboxAddress": "info@blind.dk",
    "PollingIntervalSeconds": 10,
    "InboxDataPath": "Data/inbox-samples.json",
    "ForwardRecipient": "info@blind.dk",
    "DocumentReferenceFolder": "Documents",
    "ForwardingLogPath": "Data/forwarded-log.json",
    "RoutingRules": [
      {
        "Name": "Order requests",
        "Route": "Forward",
        "Keywords": ["ordre", "bestilling", "levering"]
      },
      {
        "Name": "Invoice review",
        "Route": "Forward",
        "Keywords": ["faktura", "betaling"]
      },
      {
        "Name": "General questions",
        "Route": "ManualReview",
        "Keywords": ["spørgsmål", "samarbejde"]
      }
    ],
    "ForwardingRules": [
      {
        "Name": "Ordre og bestillinger",
        "Keywords": ["ordre", "bestilling", "levering"],
        "ForwardAddresses": ["info@blind.dk"],
        "ForwardWhenAnyKeywordMatches": true,
        "Enabled": true
      },
      {
        "Name": "Faktura og betaling",
        "Keywords": ["faktura", "betaling"],
        "ForwardAddresses": ["info@blind.dk"],
        "ForwardWhenAnyKeywordMatches": true,
        "Enabled": true
      },
      {
        "Name": "Ikke videresend",
        "Keywords": ["ikke videresend", "manuel behandling", "holdes tilbage"],
        "ForwardAddresses": [],
        "ForwardWhenAnyKeywordMatches": true,
        "Enabled": true
      }
    ]
  }
}
